# Окружение: development | test | production
NODE_ENV=development

# Порт API
PORT=4000

# Строка подключения к PostgreSQL:
# postgres://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:ПОРТ/ИМЯ_БД
# Спецсимволы в пароле (@ : / # ? %) нужно URL-кодировать, например @ -> %40
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/frame_dev

# Адрес клиента (Vite) — разрешённый origin для CORS
CLIENT_URL=http://localhost:5180

# Отдельная база для автотестов (npm test). Таблицы в ней очищаются между тестами!
TEST_DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/frame_test

# Секрет подписи access-токенов (JWT): длинная случайная строка, своя для каждого окружения.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_ACCESS_SECRET=
# Время жизни access-токена (формат jsonwebtoken: 15m, 1h…)
JWT_ACCESS_TTL=15m
# Время жизни refresh-токена в днях
REFRESH_TOKEN_TTL_DAYS=30
