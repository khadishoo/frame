# Базовый URL API. В разработке не нужен: Vite проксирует /api на localhost:4000.
# В production (этап 11) — адрес задеплоенного API, например https://api.example.com/api/v1
# VITE_API_URL=

# Кнопка «Войти как демо» на странице входа (аккаунт из сида сервера). false — скрыть
# VITE_DEMO_LOGIN=true
